#include <stdio.h>

int main() {
    int n, digit;
    int product = 1;

    printf("Enter a number: ");
    scanf("%d", &n);

    while (n > 0) {
        digit = n % 10;

        if (digit % 2 != 0) {
            product = product * digit;
        }

        n = n / 10;
    }

    printf("Product of odd digits = %d", product);

    return 0;
}
#include <stdio.h>

void complement(int n) {
    if (n == 0)
        return;

    complement(n / 10);

    if (n % 10 == 0)
        printf("1");
    else
        printf("0");
}

int main() {
    int n;

    printf("Enter a binary number: ");
    scanf("%d", &n);

    complement(n);

    return 0;
}
